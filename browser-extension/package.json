{
  "name": "clavispass-extension",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.content.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "package:chrome": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-chrome.ps1",
    "package:firefox": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-firefox.ps1",
    "package:firefox:source": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-firefox-source.ps1",
    "build:chrome": "npm run build && npm run package:chrome",
    "release:chrome": "npm run typecheck && npm run build:chrome",
    "build:firefox": "npm run build && npm run package:firefox",
    "release:firefox": "npm run typecheck && npm run build:firefox && npm run package:firefox:source"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^8.0.3"
  }
}
