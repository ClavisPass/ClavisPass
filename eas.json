{
  "cli": {
    "version": ">= 16.9.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": { "APP_VARIANT": "development" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "developmentClient": false,
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_CLAVISPASS_MOBILE_BINARY_UPDATES": "false"
      }
    },
    "production-apk": {
      "developmentClient": false,
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_CLAVISPASS_MOBILE_BINARY_UPDATES": "true"
      },
      "android": { "buildType": "apk" }
    }
  },
  "submit": {
    "production": {
      "android": {
        "applicationId": "com.clavispass.app",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
