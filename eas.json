{
  "cli": {
    "version": ">= 16.9.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": { "APP_VARIANT": "development" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "developmentClient": false,
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "env": { "APP_VARIANT": "production" }
    },
    "production-apk": {
      "developmentClient": false,
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "env": { "APP_VARIANT": "production" },
      "android": { "buildType": "apk" }
    }
  },
  "submit": {
    "production": {
      "android": {
        "applicationId": "com.clavispass.app",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
