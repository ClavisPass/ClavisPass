{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClavisPass",
  "mainBinaryName": "ClavisPass",
  "version": "1.8.2",
  "identifier": "com.ClavisPass.app",
  "build": {
    "beforeBuildCommand": "npm run web:build-tauri && npm run tauri:prepare-native-host",
    "beforeDevCommand": "npm run web",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8081"
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2026 Arratel",
    "targets": [
      "msi",
      "nsis",
      "deb",
      "appimage",
      "dmg",
      "app"
    ],
    "externalBin": [
      "binaries/clavispass_native_host"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerHooks": "./windows/native-host-hooks.nsh"
      }
    },
    "longDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": "-"
    },
    "resources": [],
    "fileAssociations": [
      {
        "ext": [
          "lock"
        ],
        "name": "ClavisPass Vault",
        "description": "ClavisPass encrypted vault file",
        "mimeType": "application/x-clavispass-vault",
        "role": "Editor"
      }
    ],
    "shortDescription": "",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "deepLink": {
      "customProtocol": "clavispass"
    },
    "cli": {
      "args": [
        {
          "name": "hidden",
          "description": "Don’t show window at startup",
          "takesValue": false
        }
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4NjM3RTZGMjIyN0Q1RDIKUldUUzFTY2liMzVqcUxhWUgyaXBTdHlqVERBQnFlZ3U2ZVlZMmtndnI5T056bGM0TDBOU0lWb3UK",
      "endpoints": [
        "https://github.com/ClavisPass/ClavisPass/releases/latest/download/updater.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  }
}
